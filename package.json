{
  "name": "aij-closer",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant AI sales agent for Lagos online vendors (monorepo root).",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@10",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,dashboard -c blue,magenta \"npm run dev --workspace @aij/api\" \"npm run dev --workspace @aij/dashboard\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash supabase/test-support/run.sh",
    "seed": "bash supabase/seed/run.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
