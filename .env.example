# ---------------------------------------------------------------------------
# AIJ Closer - example environment file. PLACEHOLDERS ONLY, never real secrets.
# Copy to .env for local development:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Runtime (used today by the api skeleton) ------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Supabase (Postgres, Auth, Storage) ------------------------------------
# Project URL and keys: Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-side only. Never expose this key to the dashboard/browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Direct Postgres connection string: Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- Anthropic (conversation drafting) -------------------------------------
# API key: https://console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Model IDs come from env so they can be swapped without a redeploy of code.
# Use the current Haiku and Sonnet model IDs from the Anthropic docs.
ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5
ANTHROPIC_MODEL_ESCALATION=claude-sonnet-4-5

# --- Meta (WhatsApp Cloud API + Instagram Messaging, one app) --------------
# Meta app dashboard: https://developers.facebook.com/apps
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Arbitrary shared string that Meta echoes back on webhook verification.
META_VERIFY_TOKEN=your-meta-webhook-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
INSTAGRAM_ACCOUNT_ID=your-instagram-business-account-id

# --- Paystack (payments go to the vendor's subaccount) ---------------------
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# --- Speech-to-text (voice notes) ------------------------------------------
# Adapter key for the STT provider behind the interface (e.g. openai, deepgram).
STT_PROVIDER=openai
STT_API_KEY=your-stt-api-key

# --- Encryption ------------------------------------------------------------
# Key used to encrypt channel access tokens at rest. Generate your own with:
#   openssl rand -base64 32
# (The value below is a throwaway placeholder so a copied .env still boots.)
CHANNEL_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
